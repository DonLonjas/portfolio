{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    { "source": "/(logo-48|logo-192)\\.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(styles\\.css|main\\.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
